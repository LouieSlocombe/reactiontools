    given-names: Louie
    email: louies@hotmail.co.uk
version: 1.0.0
date-released: "2026-09-18"
license: MIT
repository-code: "https://github.com/LouieSlocombe/reactiontools"
url: "https://reactiontools.readthedocs.io"
keywords:
  - chemistry
  - computational-chemistry
  - transition-state
  - nudged-elastic-band
  - metadynamics
  - plumed
  - orca
  - ase
